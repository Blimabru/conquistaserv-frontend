# ==============================================================================
# CONFIGURAÇÕES DA APLICAÇÃO (FRONT-END)
# ==============================================================================
# Este bloco define as propriedades básicas utilizadas pelo cliente (navegador).

# APP_NAME
# Nome oficial da aplicação, exibido na barra de título do navegador e em
# metadados da aplicação.
APP_NAME="ConquistaServ Front-end"

# VERSION
# Especifica a versão atual da interface de usuário.
VERSION=1.0.0


# ==============================================================================
# CONFIGURAÇÕES DE REDE E PROTOCOLOS
# ==============================================================================

# PORT
# Porta na qual o servidor de desenvolvimento do Front-end será executado.
PORT=8080

# PROTOCOL
# Protocolo padrão para acesso local e construção de URLs base.
PROTOCOL=http


# ==============================================================================
# URLS DE ACESSO E COMUNICAÇÃO (API)
# ==============================================================================

# BASE_URL
# URL base para acesso direto à interface do Front-end.
# Em produção, será o domínio principal (ex: https://brainstormlabs.online).
BASE_URL=http://localhost:8080/

# API_BASE_URL
# URL base pela qual o Front-end fará requisições HTTP para o Back-end (API).
# Em produção, apontará para o subdomínio da API (ex: https://api.brainstormlabs.online/).
API_BASE_URL=http://localhost:3006/
